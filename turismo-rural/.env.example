# Opcional: copia este archivo a .env (junto a docker-compose.yml) para cambiar la configuración.
# Sin .env, docker compose usa los valores por defecto y todo funciona en http://localhost.

# Firma de las sesiones (JWT). En producción, una cadena larga y aleatoria
SECRET_KEY=clave-de-desarrollo-cambiala-en-produccion

# Puerto del equipo donde queda la app (si el 80 está ocupado, p. ej. 8080)
PUERTO=80
# Dirección pública de la app, para los enlaces de los correos y las páginas de pago.
# Si cambias PUERTO, inclúyelo: http://localhost:8080
FRONTEND_URL=http://localhost
# Destino de los avisos de pago. Con Mercado Pago, una URL pública: https://tudominio.cl/api
BACKEND_URL=http://localhost:8000

# --- Correo: por defecto va a Mailpit (http://localhost:8025). Para un SMTP real: ---
# MAIL_SERVER=smtp.ejemplo.com
# MAIL_PORT=587
# MAIL_USERNAME=usuario
# MAIL_PASSWORD=contraseña
# MAIL_FROM=reservas@tudominio.cl
# MAIL_STARTTLS=true
# MAIL_ENVIAR=false            # desactiva el envío

# --- Pagos: por defecto la pasarela simulada. Para Mercado Pago: ---
# PROVEEDOR_PAGO=mercadopago
# MP_ACCESS_TOKEN=TEST-...
# MP_WEBHOOK_SECRET=...
# MP_SANDBOX=true
