# Copia este archivo a .env (junto a compose.yaml) y cambia POSTGRES_PASSWORD:
#   Windows PowerShell: Copy-Item .env.example .env
#   macOS / Linux:      cp .env.example .env
# El .env no se sube a Git (.gitignore).

# --- Base de datos ---
POSTGRES_DB=turismo_rural
POSTGRES_USER=turismo
# Obligatoria. Solo letras, números, - y _ (va dentro de la URL de conexión).
# Se aplica al crear el volumen: si ya existe, cambiarla aquí no cambia la del usuario en la base.
POSTGRES_PASSWORD=REEMPLAZAR_CON_CLAVE_DISTINTA

# --- Puertos del equipo (ligados a 127.0.0.1) ---
# App en http://localhost:8080
WEB_PORT=8080
# API directa: http://localhost:8000/docs y http://localhost:8000/health
API_PORT=8000
# Correos atrapados por Mailpit: http://localhost:8025
MAIL_UI_PORT=8025

# Firma de las sesiones (JWT). En producción, una cadena larga y aleatoria
SECRET_KEY=clave-de-desarrollo-cambiala-en-produccion

# Dirección pública de la app, para los enlaces de los correos y las páginas de pago.
# Por defecto http://localhost:<WEB_PORT>
# FRONTEND_URL=http://localhost:8080
# Destino de los avisos de pago de un proveedor externo (Mercado Pago): una URL pública,
# p. ej. https://tudominio.cl/api. La pasarela simulada no la usa: avisa a la propia API por su
# dirección interna (http://127.0.0.1:8000/pagos/webhook), así que no hay que cambiarla con API_PORT.
BACKEND_URL=http://localhost:8000

# --- Correo: por defecto va a Mailpit (http://localhost:8025). Para un SMTP real: ---
# MAIL_SERVER=smtp.ejemplo.com
# MAIL_PORT=587
# MAIL_USERNAME=usuario
# MAIL_PASSWORD=contraseña
# MAIL_FROM=reservas@tudominio.cl
# MAIL_STARTTLS=true
# MAIL_ENVIAR=false            # desactiva el envío

# --- Pagos: por defecto la pasarela simulada. Para Mercado Pago: ---
# PROVEEDOR_PAGO=mercadopago
# MP_ACCESS_TOKEN=TEST-...
# MP_WEBHOOK_SECRET=...
# MP_SANDBOX=true
